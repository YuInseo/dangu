{
  "appId": "com.donghaeng.app",
  "appName": "동행",
  "webDir": "www",
  "server": {
    "androidScheme": "http",
    "iosScheme": "http"
  },
  "android": {
    "allowMixedContent": true
  },
  "ios": {
    "contentInset": "always"
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com"
      ]
    }
  }
}
