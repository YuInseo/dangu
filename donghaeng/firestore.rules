rules_version = '2';

/*
 * 동행의 규칙.
 *
 * 동행 전용 Firebase 프로젝트(motion-8b939)의 Firestore 규칙이다. 콘솔의 규칙 탭에 이
 * 파일을 통째로 붙여넣으면 된다. 여기 없는 경로는 전부 거절된다(규칙의 기본값).
 *
 * 요약하면: 팀 코드를 알아야 들어갈 수 있고, 들어온 사람만 쪽지를 읽고 쓴다.
 */
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function member(team) {
      return signedIn() && exists(/databases/$(database)/documents/teams/$(team)/members/$(request.auth.uid));
    }

    match /teams/{team} {
      // 코드로 하나를 집어 읽는 것만 된다. 목록(list)은 막혀 있어서 코드를 모르면
      // 어떤 팀이 있는지조차 알 수 없다.
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60;
      allow update: if member(team)
        && request.resource.data.createdBy == resource.data.createdBy;

      // 구성원 문서는 자기 것만 만들고 지운다. 팀이 있어야 들어갈 수 있다.
      match /members/{uid} {
        allow read: if member(team);
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && exists(/databases/$(database)/documents/teams/$(team));
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      match /slips/{slip} {
        allow read: if member(team);
        // 완료된 쪽지는 지울 수 없다 — 기록이다. 보관 기한 정리(하루가 지난 것)만 예외.
        allow delete: if member(team)
          && (resource.data.status != 'done'
              || resource.data.createdAt < request.time.toMillis() - 86400000);
        allow create, update: if member(team)
          && request.resource.data.date is string
          && request.resource.data.time is string
          && request.resource.data.kind in ['depart', 'arrive']
          && request.resource.data.status in ['waiting', 'doing', 'done'];
      }
    }
  }
}
