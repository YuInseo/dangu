# 이 파일을 .env.local로 복사해 값을 채우면 로그인과 클라우드 저장이 켜집니다.
# 하나도 채우지 않아도 앱은 완전히 동작합니다 — 기록이 이 기기에만 남을 뿐입니다.

# ── Firebase 웹 설정 ────────────────────────────────────────────────
# Firebase 콘솔 → 프로젝트 설정 → 내 앱 → 웹 앱 → SDK 설정 및 구성에서 그대로 옮깁니다.
# 이 값들은 공개되어도 되는 값입니다. 실제 보호는 firestore.rules가 합니다.
#
# 비워 두어도 됩니다 — graft.config.ts에 이 프로젝트의 값이 기본값으로 적혀 있습니다.
# 여기에 채우면 그쪽 대신 이 값으로 빌드됩니다(다른 Firebase 프로젝트를 쓸 때).
GRAFT_PUBLIC_FIREBASE_API_KEY=
GRAFT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
GRAFT_PUBLIC_FIREBASE_PROJECT_ID=your-project
GRAFT_PUBLIC_FIREBASE_APP_ID=
GRAFT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
GRAFT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# ── 인앱 업데이트 ───────────────────────────────────────────────────
# 릴리스를 확인할 공개 저장소. 비어 있으면 업데이트 버튼이 "설정되지 않음"이라고 말합니다.
GRAFT_PUBLIC_GITHUB_REPO=your-name/billiard

# ── 릴리스 서명 (CI에서만 필요) ─────────────────────────────────────
# GitHub Actions에서는 시크릿으로 넣습니다. 로컬 빌드는 디버그 키로 서명됩니다.
# GRAFT_ANDROID_KEYSTORE=release.keystore
# GRAFT_ANDROID_KEY_ALIAS=upload
# GRAFT_ANDROID_KEYSTORE_PASSWORD=
# GRAFT_ANDROID_KEY_PASSWORD=
